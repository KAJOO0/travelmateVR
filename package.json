{
  "name": "travelmatevr",
  "private": true,
  "version": "0.1.0",
  "description": "TravelMateVR — immersive tourism ecosystem by Mates Technologies Limited",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "media": "node scripts/optimize-media.mjs",
    "videos": "node scripts/build-videos.mjs",
    "i18n:check": "node scripts/check-locales.mjs",
    "migrate:seed": "tsx scripts/migrate-seed-to-amplify.ts",
    "deploy": "npm run build && npx -y netlify-cli deploy --prod --dir dist --no-build --site travelmatevr.netlify.app"
  },
  "dependencies": {
    "aws-amplify": "^6.22.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
