# Copy to .env.local. Only VITE_* values are exposed to the browser — never put secrets here.

# Base URL of the TravelMateVR API gateway. Leave empty to run on the built-in demo data layer.
VITE_API_BASE_URL=

# "mock" uses seeded demo data; "http" calls VITE_API_BASE_URL.
VITE_DATA_SOURCE=mock

# Public site origin, used for share links.
VITE_SITE_URL=https://travelmatevr.com

# Server-side only (configure on the backend, NOT here):
#   AI provider keys, payment gateway keys, WhatsApp Business API token,
#   email/SMS provider credentials, storage credentials.

# Map tiles (public, domain-restricted keys only). Empty = OpenStreetMap's keyless server, suitable for
# previews and light traffic only. For production use a provider such as MapTiler, Stadia or Mapbox, e.g.
#   VITE_MAP_TILES_LIGHT=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_PUBLIC_KEY
#   VITE_MAP_TILES_DARK=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_PUBLIC_KEY
VITE_MAP_TILES_LIGHT=
VITE_MAP_TILES_DARK=
VITE_MAP_ATTRIBUTION=
